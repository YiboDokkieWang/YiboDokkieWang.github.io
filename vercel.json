{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/publication-manager.js": {
      "maxDuration": 60,
      "includeFiles": "{contents/**,publication-monitor/config.json,publication-monitor/state.json,publication-monitor/cache/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:action",
      "destination": "/api/publication-manager?action=:action"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
